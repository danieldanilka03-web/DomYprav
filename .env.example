# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AUTH_SESSION_SECRET: Secret key used to sign HTTP-only session cookies for email/password login.
AUTH_SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# PostgreSQL runtime connection variables (injected automatically by Cloud SQL runtime)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
